# ShilpKala Backend Configuration
# ═══════════════════════════════════════════════════════════════
# Honesty Contract: Modules 4 & 5 are simulated; Phases 1 & 2 are 100% genuine.

# Database
# Default: PostgreSQL. Automatically falls back to SQLite for zero-config offline runs.
#
# Phase 1: point this at your Supabase project's connection string.
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
# Use the POOLED (pgBouncer, port 6543) string for app traffic; add
# ?sslmode=require. Keep credentials out of git, e.g.:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shilpkala

# ── Supabase Auth (Phase 1) ────────────────────────────────────────────────
# Project Settings → API. Leave blank to keep Supabase auth disabled; the
# middleware then runs in permissive (annotate-only) mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → JWT Settings → JWT Secret. Only needed for legacy HS256
# projects; modern projects are verified via the project JWKS endpoint instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Set true to reject unauthenticated requests on protected routes. Keep false
# while developing so the demo and test suite keep working.
AUTH_ENABLED=false

# Voice Pipeline (Phase 2 - Sarvam Primary)
SARVAM_API_KEY=your_sarvam_api_key_here
BHASHINI_API_KEY=your_bhashini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# AI Listing Generation (Groq Primary, Anthropic Fallback)
GROQ_API_KEY=your_groq_api_key_here            # primary LLM for listing generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # fallback for listing generation only
OPENAI_API_KEY=your_openai_api_key_here        # optional tertiary fallback

# Credit-Conservation & Demo Safety Net
# When true, known demo inputs across 9 languages are served from instant cache
# to conserve finite Sarvam/LLM credits during live development & rehearsals.
DEMO_MODE=false

# Recommendation demand signal: attempts live Google Trends via pytrends
# (unofficial, currently rate-limited by Google as of testing) with automatic
# fallback to a static seasonal-demand table — the static table is the
# reliable path, treat pytrends as a bonus.
# No API key is needed for pytrends.


# Object Storage (S3 / Cloud Storage / Local Disk Wrapper)
CLOUD_STORAGE_BUCKET=shilpkala-assets
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:8000

# App Settings
ENVIRONMENT=development
LOG_LEVEL=info
